rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner() {
      return request.auth != null
        && request.auth.token.email == 'bddayma12@gmail.com';
    }

    // Courses: public catalogue, owner-managed.
    match /courses/{courseId} {
      allow read: if true;
      allow create, update, delete: if isOwner();
    }

    // Existing private operational data.
    match /students/{studentId} { allow read, write: if isOwner(); }
    match /leads/{leadId} { allow read, write: if isOwner(); }
    match /attendance/{recordId} { allow read, write: if isOwner(); }
    match /registrationLocks/{lockId} { allow read, write: if false; }
    match /adminDevices/{deviceId} { allow read, write: if isOwner(); }

    // Public reviews with validation.
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly([
          'name', 'rating', 'text', 'createdAt', 'timestamp'
        ])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 80
        && request.resource.data.text is string
        && request.resource.data.text.size() >= 5
        && request.resource.data.text.size() <= 600
        && request.resource.data.rating is string
        && request.resource.data.rating in ['3', '4', '5'];
      allow update, delete: if isOwner();
    }

    // Calling Community is server-mediated. Profiles, location preferences,
    // invitations, sessions, reports and moderation history must never be read
    // or written directly by a browser client.
    match /callingProfiles/{userId} { allow read, write: if false; }
    match /callingQueues/{userId} { allow read, write: if false; }
    match /callingSessions/{sessionId} { allow read, write: if false; }
    match /callingBlocks/{blockId} { allow read, write: if false; }
    match /callingReports/{reportId} { allow read, write: if false; }
    match /callingModerationAudit/{auditId} { allow read, write: if false; }
    match /callingRateLimits/{limitId} { allow read, write: if false; }
    match /callingPartnerRequests/{requestId} { allow read, write: if false; }
    match /callingPartnerConnections/{connectionId} { allow read, write: if false; }
    match /callingFailures/{failureId} { allow read, write: if false; }
    match /callingPartnerRequestsPreview/{requestId} { allow read, write: if false; }
    match /callingPartnerConnectionsPreview/{connectionId} { allow read, write: if false; }
    match /callingFailuresPreview/{failureId} { allow read, write: if false; }

    // LMS content and student/payment records are accessed only by Netlify Functions.
    // Admin SDK operations are authenticated and authorized in the LMS API.
    match /lmsCourses/{courseId} { allow read, write: if false; }
    match /lmsCoursesPreview/{courseId} { allow read, write: if false; }
    match /lmsCourseContent/{courseId}/{document=**} { allow read, write: if false; }
    match /lmsCourseContentPreview/{courseId}/{document=**} { allow read, write: if false; }
    match /userProfiles/{uid} { allow read, write: if false; }
    match /userProfilesPreview/{uid} { allow read, write: if false; }
    match /enrollments/{enrollmentId} { allow read, write: if false; }
    match /enrollmentsPreview/{enrollmentId} { allow read, write: if false; }
    match /payments/{paymentId} { allow read, write: if false; }
    match /paymentsPreview/{paymentId} { allow read, write: if false; }
    match /studentProgress/{progressId} { allow read, write: if false; }
    match /studentProgressPreview/{progressId} { allow read, write: if false; }
    match /adminLogs/{logId} { allow read, write: if false; }
    match /adminLogsPreview/{logId} { allow read, write: if false; }
    match /courseReviews/{reviewId} { allow read, write: if false; }
    match /courseReviewsPreview/{reviewId} { allow read, write: if false; }
    match /userNotifications/{notificationId} { allow read, write: if false; }
    match /userNotificationsPreview/{notificationId} { allow read, write: if false; }
    match /certificates/{certificateId} { allow read, write: if false; }
    match /certificatesPreview/{certificateId} { allow read, write: if false; }

    // Default-deny for all other collections, including tutor service data that
    // is accessed only through Netlify Functions using Firebase Admin SDK.
    match /{document=**} { allow read, write: if false; }
  }
}
